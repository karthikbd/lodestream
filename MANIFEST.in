include README.md LICENSE THIRD_PARTY_NOTICES.md SECURITY.md CHANGELOG.md .readthedocs.yaml
recursive-include docs *.md *.py *.css *.svg *.html *.js *.toml
recursive-include tests *.py *.sql *.yml
recursive-include ci *.in *.txt *.py
prune .codacy
prune docs/_build
prune docs/reference/_generated
global-exclude __pycache__ *.pyc
